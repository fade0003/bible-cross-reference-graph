:patterns-of-grace a owl:Class ;
  rdfs:label "Patterns of Grace (Typology)" ;
  rdfs:comment "Old Testament persons, objects, and rites that the New Testament reads as deliberately-designed shadows of a greater, later reality in Christ - patterns of grace running ahead of their own fulfillment." .

:type-adam a owl:NamedIndividual, :Type ;
  rdfs:label "Adam & Christ: the Two Heads" ;
  rdfs:comment "As in Adam all die, so in Christ - the 'last Adam' - all who are his are made alive." ;
  :partOf :patterns-of-grace ;
  :verse "Rom.5.12-Rom.5.19" ;
  :verse "1Cor.15.22" ;
  :verse "1Cor.15.45" .

:type-passover-lamb a owl:NamedIndividual, :Type ;
  rdfs:label "The Passover Lamb" ;
  rdfs:comment "A spotless lamb, blood applied, none of its bones broken - John the Baptist's 'Lamb of God' language and Paul's 'Christ, our Passover lamb' make the pattern explicit." ;
  :partOf :patterns-of-grace ;
  :verse "Exod.12.1-Exod.12.13" ;
  :verse "John.1.29" ;
  :verse "1Cor.5.7" .

:type-bronze-serpent a owl:NamedIndividual, :Type ;
  rdfs:label "The Bronze Serpent" ;
  rdfs:comment "Whoever looked at the serpent Moses lifted up lived - Jesus applies the pattern to himself directly, lifted up so that whoever believes may have eternal life." ;
  :partOf :patterns-of-grace ;
  :verse "Num.21.4-Num.21.9" ;
  :verse "John.3.14-John.3.15" .

:type-manna a owl:NamedIndividual, :Type ;
  rdfs:label "Manna from Heaven" ;
  rdfs:comment "Bread given daily in the wilderness, versus the 'true bread from heaven' that gives life to the world." ;
  :partOf :patterns-of-grace ;
  :verse "Exod.16.4" ;
  :verse "Exod.16.15" ;
  :verse "John.6.31-John.6.35" ;
  :verse "John.6.48-John.6.51" .

:type-day-of-atonement a owl:NamedIndividual, :Type ;
  rdfs:label "The Scapegoat & Day of Atonement" ;
  rdfs:comment "One goat's blood atones, another carries the people's sin away into the wilderness - a two-part picture of substitution Hebrews and Paul both draw on." ;
  :partOf :patterns-of-grace ;
  :verse "Lev.16.7-Lev.16.10" ;
  :verse "Lev.16.20-Lev.16.22" ;
  :verse "Heb.9.11-Heb.9.14" ;
  :verse "2Cor.5.21" .

:type-jonah-sign a owl:NamedIndividual, :Type ;
  rdfs:label "The Sign of Jonah" ;
  rdfs:comment "Three days and three nights in the fish's belly, offered by Jesus himself as the one sign this generation will be given." ;
  :partOf :patterns-of-grace ;
  :verse "Jonah.1.17" ;
  :verse "Matt.12.39-Matt.12.40" .

:type-rock a owl:NamedIndividual, :Type ;
  rdfs:label "The Rock That Followed Them" ;
  rdfs:comment "Water struck from the rock in the wilderness; Paul identifies the rock itself as Christ." ;
  :partOf :patterns-of-grace ;
  :verse "Exod.17.6" ;
  :verse "Num.20.7-Num.20.11" ;
  :verse "1Cor.10.4" .

:type-melchizedek-bread-wine a owl:NamedIndividual, :Type ;
  rdfs:label "Melchizedek's Bread and Wine" ;
  rdfs:comment "Read by many in this tradition as the Old Testament's first foreshadowing of the Lord's Supper, offered by the very priest-king who prefigures Christ's own priesthood." ;
  :partOf :patterns-of-grace ;
  :verse "Gen.14.18" ;
  :verse "Matt.26.26-Matt.26.28" .

:type-flood-baptism a owl:NamedIndividual, :Type ;
  rdfs:label "The Flood as a Pattern of Baptism" ;
  rdfs:comment "Peter explicitly names Noah's family, brought safely through water, as corresponding to baptism, which now saves through Christ's resurrection." ;
  :partOf :patterns-of-grace ;
  :verse "Gen.6.1-Gen.8.22" ;
  :verse "1Pet.3.20-1Pet.3.21" .
